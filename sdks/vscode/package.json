{
  "name": "supercode",
  "displayName": "Supercode",
  "description": "Supercode - AI coding agent for VS Code",
  "version": "0.6.48",
  "publisher": "KiranMadipally",
  "repository": {
    "type": "git",
    "url": "https://github.com/kirmad/supercode"
  },
  "bugs": {
    "url": "https://github.com/kirmad/supercode/issues"
  },
  "homepage": "https://github.com/kirmad/supercode",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "keywords": [
    "ai",
    "coding",
    "assistant",
    "supercode",
    "opencode",
    "terminal"
  ],
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "supercode.openTerminal",
        "title": "Open supercode",
        "icon": {
          "light": "images/button-dark.svg",
          "dark": "images/button-light.svg"
        }
      },
      {
        "command": "supercode.openNewTerminal",
        "title": "Open supercode in new tab",
        "icon": {
          "light": "images/button-dark.svg",
          "dark": "images/button-light.svg"
        }
      },
      {
        "command": "supercode.addFilepathToTerminal",
        "title": "Add Filepath to Terminal"
      },
      {
        "command": "supercode.sendFileToChat",
        "title": "SuperCode: Send to Chat",
        "category": "SuperCode"
      },
      {
        "command": "supercode.sendSelectionToChat",
        "title": "SuperCode: Send Selection to Chat",
        "category": "SuperCode"
      },
      {
        "command": "supercode.sendCurrentFileToChat",
        "title": "SuperCode: Send File to Chat",
        "category": "SuperCode"
      },
      {
        "command": "supercode.openStaticWebview",
        "title": "Open SuperCode Static Interface",
        "category": "SuperCode"
      },
      {
        "command": "supercode.connectToExisting",
        "title": "Connect to Existing SuperCode Instance",
        "category": "SuperCode"
      },
      {
        "command": "supercode.explainSelection",
        "title": "Explain Selection",
        "category": "SuperCode"
      },
      {
        "command": "supercode.refactorSelection",
        "title": "Refactor Selection",
        "category": "SuperCode"
      },
      {
        "command": "supercode.addCommentsToSelection",
        "title": "Add Comments",
        "category": "SuperCode"
      },
      {
        "command": "supercode.debugSelection",
        "title": "Debug Selection",
        "category": "SuperCode"
      },
      {
        "command": "supercode.optimizeSelection",
        "title": "Optimize Selection",
        "category": "SuperCode"
      },
      {
        "command": "supercode.reviewGeneral",
        "title": "General Review",
        "category": "SuperCode"
      },
      {
        "command": "supercode.reviewSecurity",
        "title": "Security-Focused Review",
        "category": "SuperCode"
      },
      {
        "command": "supercode.reviewDesign",
        "title": "Design Review",
        "category": "SuperCode"
      },
      {
        "command": "supercode.reviewDefensive",
        "title": "Defensive Coding Review",
        "category": "SuperCode"
      },
      {
        "command": "supercode.showDynamicCommands",
        "title": "SuperCode: Run custom prompt",
        "category": "SuperCode"
      },
      {
        "command": "supercode.explainFile",
        "title": "Explain File",
        "category": "SuperCode"
      },
      {
        "command": "supercode.refactorFile",
        "title": "Refactor File",
        "category": "SuperCode"
      },
      {
        "command": "supercode.addCommentsToFile",
        "title": "Add Comments to File",
        "category": "SuperCode"
      },
      {
        "command": "supercode.debugFile",
        "title": "Debug File",
        "category": "SuperCode"
      },
      {
        "command": "supercode.optimizeFile",
        "title": "Optimize File",
        "category": "SuperCode"
      },
      {
        "command": "supercode.reviewFileGeneral",
        "title": "General Review (File)",
        "category": "SuperCode"
      },
      {
        "command": "supercode.reviewFileSecurity",
        "title": "Security Review (File)",
        "category": "SuperCode"
      },
      {
        "command": "supercode.reviewFileDesign",
        "title": "Design Review (File)",
        "category": "SuperCode"
      },
      {
        "command": "supercode.reviewFileDefensive",
        "title": "Defensive Coding Review (File)",
        "category": "SuperCode"
      },
      {
        "command": "supercode.showDynamicCommandsForFile",
        "title": "SuperCode: Run custom prompt",
        "category": "SuperCode"
      },
      {
        "command": "supercode.createADOWorkspaceConfig",
        "title": "Create ADO Workspace Config",
        "category": "SuperCode"
      },
      {
        "command": "supercode.openADOWorkspaceConfig",
        "title": "Open ADO Workspace Config",
        "category": "SuperCode"
      }
    ],
    "submenus": [
      {
        "id": "supercode.selection",
        "label": "SuperCode"
      },
      {
        "id": "supercode.review",
        "label": "Review"
      },
      {
        "id": "supercode.commands",
        "label": "Commands"
      },
      {
        "id": "supercode.file",
        "label": "SuperCode"
      },
      {
        "id": "supercode.fileReview",
        "label": "Review"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "supercode.openNewTerminal",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "submenu": "supercode.selection",
          "when": "editorHasSelection",
          "group": "supercode"
        },
        {
          "submenu": "supercode.file",
          "when": "!editorHasSelection",
          "group": "supercode"
        },
        {
          "command": "supercode.sendSelectionToChat",
          "when": "editorHasSelection",
          "group": "supercode@1"
        },
        {
          "command": "supercode.sendCurrentFileToChat",
          "when": "!editorHasSelection",
          "group": "supercode@1"
        },
        {
          "command": "supercode.showDynamicCommands",
          "when": "editorHasSelection",
          "group": "supercode@2"
        },
        {
          "command": "supercode.showDynamicCommandsForFile",
          "when": "!editorHasSelection",
          "group": "supercode@2"
        }
      ],
      "explorer/context": [
        {
          "submenu": "supercode.file",
          "when": "resourceScheme == file || explorerResourceIsFolder",
          "group": "supercode"
        },
        {
          "command": "supercode.sendFileToChat",
          "when": "resourceScheme == file || explorerResourceIsFolder",
          "group": "supercode@1"
        },
        {
          "command": "supercode.showDynamicCommandsForFile",
          "when": "resourceScheme == file",
          "group": "supercode@2"
        }
      ],
      "supercode.file": [
        {
          "command": "supercode.explainFile",
          "group": "analyze@1"
        },
        {
          "command": "supercode.debugFile",
          "group": "analyze@2"
        },
        {
          "submenu": "supercode.fileReview",
          "group": "review@1"
        },
        {
          "command": "supercode.refactorFile",
          "group": "improve@1"
        },
        {
          "command": "supercode.addCommentsToFile",
          "group": "improve@2"
        },
        {
          "command": "supercode.optimizeFile",
          "group": "improve@3"
        }
      ],
      "supercode.fileReview": [
        {
          "command": "supercode.reviewFileGeneral",
          "group": "review@1"
        },
        {
          "command": "supercode.reviewFileSecurity",
          "group": "review@2"
        },
        {
          "command": "supercode.reviewFileDesign",
          "group": "review@3"
        },
        {
          "command": "supercode.reviewFileDefensive",
          "group": "review@4"
        }
      ],
      "supercode.selection": [
        {
          "command": "supercode.explainSelection",
          "group": "analyze@1"
        },
        {
          "command": "supercode.debugSelection",
          "group": "analyze@2"
        },
        {
          "submenu": "supercode.review",
          "group": "review@1"
        },
        {
          "command": "supercode.refactorSelection",
          "group": "improve@1"
        },
        {
          "command": "supercode.addCommentsToSelection",
          "group": "improve@2"
        },
        {
          "command": "supercode.optimizeSelection",
          "group": "improve@3"
        }
      ],
      "supercode.review": [
        {
          "command": "supercode.reviewGeneral",
          "group": "review@1"
        },
        {
          "command": "supercode.reviewSecurity",
          "group": "review@2"
        },
        {
          "command": "supercode.reviewDesign",
          "group": "review@3"
        },
        {
          "command": "supercode.reviewDefensive",
          "group": "review@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "supercode.openTerminal",
        "title": "Run supercode",
        "key": "cmd+escape",
        "mac": "cmd+escape",
        "win": "ctrl+escape",
        "linux": "ctrl+escape"
      },
      {
        "command": "supercode.openNewTerminal",
        "title": "Run supercode",
        "key": "cmd+shift+escape",
        "mac": "cmd+shift+escape",
        "win": "ctrl+shift+escape",
        "linux": "ctrl+shift+escape"
      },
      {
        "command": "supercode.addFilepathToTerminal",
        "title": "supercode: Insert At-Mentioned",
        "key": "cmd+alt+k",
        "mac": "cmd+alt+k",
        "win": "ctrl+alt+K",
        "linux": "ctrl+alt+K"
      }
    ],
    "configuration": {
      "title": "SuperCode",
      "properties": {
        "supercode.terminal.windows.preferWezTerm": {
          "type": "boolean",
          "default": true,
          "description": "Prefer WezTerm over cmd.exe on Windows when available"
        },
        "supercode.terminal.windows.weztermPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to wezterm-gui.exe. Leave empty for auto-detection"
        },
        "supercode.terminal.windows.weztermArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["start", "--cwd", "{workspaceFolder}", "--", "cmd", "/c", "{command}"],
          "description": "Custom WezTerm arguments. Use {workspaceFolder} and {command} placeholders"
        },
        "supercode.terminal.windows.weztermPreferEgl": {
          "type": "boolean",
          "default": false,
          "description": "Add --config 'prefer_egl=true' flag to WezTerm for better graphics performance"
        },
        "supercode.terminal.macOS.terminal": {
          "type": "string",
          "enum": ["Terminal", "iTerm2"],
          "default": "Terminal",
          "description": "Preferred terminal application on macOS"
        },
        "supercode.terminal.linux.terminal": {
          "type": "string",
          "default": "auto",
          "description": "Preferred terminal application on Linux. Use 'auto' for auto-detection"
        },
        "supercode.terminal.workingDirectory": {
          "type": "string",
          "enum": ["workspace", "current"],
          "default": "workspace",
          "description": "Working directory for SuperCode terminal: 'workspace' (VS Code workspace) or 'current' (extension process directory)"
        },
        "supercode.ui.method": {
          "type": "string",
          "enum": ["static", "terminal"],
          "default": "static",
          "description": "UI method for SuperCode: 'static' uses static webview + TUI (recommended), 'terminal' uses terminal-only interface"
        },
        "supercode.ui.reuseInstance": {
          "type": "boolean",
          "default": true,
          "description": "When true, 'Open SuperCode' will connect to existing instances if available. When false, always creates a new instance."
        },
        "supercode.azureDevOps.organization": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps organization name (e.g., 'mycompany' from https://dev.azure.com/mycompany)"
        },
        "supercode.azureDevOps.project": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps project name"
        },
        "supercode.azureDevOps.pat": {
          "type": "string",
          "default": "",
          "markdownDescription": "Azure DevOps Personal Access Token with appropriate permissions (Work Items: Read, Code: Read, Pull Request: Read). **Note:** This is stored as plain text in VS Code settings.",
          "scope": "machine"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run package",
    "compile": "bun run check-types && bun run lint && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "bun run check-types && bun run lint && bun run copy-static && node esbuild.js --production",
    "copy-static": "mkdir -p static && cp -r ../../packages/vscode-webview/vscode-static/* static/",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "bun run compile-tests && bun run compile && bun run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.3.1",
    "@types/vscode": "^1.94.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "eventsource": "^4.0.0",
    "@kirmad/supercode-sdk": "*"
  }
}
