{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "mcp": {
      "serena": {
          "type": "local",
          "command": [
              "uvx",
              "--from",
              "git+https://github.com/oraios/serena",
              "serena-mcp-server",
              "--context",
              "ide-assistant",
              "--project",
              "/git/cs"
          ],
          "enabled": true
      },
      "sequential-thinking": {
          "type": "local",
          "command": [
              "npx",
              "-y",
              "@modelcontextprotocol/server-sequential-thinking"
          ],
          "enabled": true
      },
      "context7": {
          "type": "local",
          "command": [
              "npx",
              "-y",
              "@upstash/context7-mcp"
          ],
          "enabled": true
      }
  }
}