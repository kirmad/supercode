{
  "name": "@supercode/vscode-webview",
  "version": "0.6.49",
  "description": "Vite-based web interface for SuperCode VS Code extension",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "dev:standalone": "vite --mode standalone",
    "build": "vite build",
    "build:static": "vite build && node scripts/build-static-files.js",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test:ws": "jest test/websocket-puppeteer.test.ts",
    "test:ws:headless": "HEADLESS=true jest test/websocket-puppeteer.test.ts",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:prompt": "playwright test prompt-generation",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@kirmad/supercode-sdk": "latest",
    "@kirmad/supercode-project-workflow": "workspace:*",
    "@supercode/azure-devops": "workspace:*",
    "lucide-vue-next": "0.545.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.0",
    "@types/puppeteer": "^7.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "buffer": "6.0.3",
    "jest": "^29.5.0",
    "process": "0.11.10",
    "puppeteer": "^22.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.8.0",
    "util": "0.12.5",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0",
    "ws": "8.18.3"
  }
}