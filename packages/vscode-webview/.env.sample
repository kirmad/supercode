# Azure DevOps Configuration
# Copy this file to .env and fill in your actual values

# Your Azure DevOps organization name (without the full URL)
# Example: If your URL is https://dev.azure.com/mycompany, use "mycompany"
AZURE_DEVOPS_ORG=your-organization

# Your Azure DevOps project name
AZURE_DEVOPS_PROJECT=your-project

# Your Azure DevOps Personal Access Token (PAT)
# Generate one at: https://dev.azure.com/{organization}/_usersSettings/tokens
# Required scopes: Work Items (Read), Code (Read), Pull Request (Read)
AZURE_DEVOPS_PAT=your-personal-access-token

# Optional: Test work item IDs (comma-separated)
# TEST_WORK_ITEMS=123456,789012,345678

# Note: Vite will automatically load these from your .env file
# Make sure your .env file is in the packages/vscode-webview directory